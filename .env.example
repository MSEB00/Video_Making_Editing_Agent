# ─────────────────────────────────────────────────────────────────────────────
# Gaming Video Agent — environment configuration template
# Copy to .env and fill in. NEVER commit .env or any credentials file.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI provider (creative editing mode) ─────────────────────────────────────
# "gemini" (default, via OpenAI-compatible endpoint) or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── YouTube Data API v3 (research / reference discovery) ────────────────────
# Any one of these is read (first takes precedence)
YOUTUBE_DATA_API_KEY=
YOUTUBE_API_KEY=

# ── YouTube upload (OAuth 2.0 desktop client) ───────────────────────────────
# Google Cloud Console → Credentials → OAuth client (Desktop app) → download
# JSON → save under credentials/ (gitignored). Keep these files local only.
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
# private | unlisted | public  (uploads default to private — recommended)
YOUTUBE_PRIVACY_STATUS=private

# ── YouTube research scheduler (dashboard background discovery) ─────────────
YOUTUBE_RESEARCH_ENABLED=false
YOUTUBE_RESEARCH_INTERVAL_SECONDS=86400
YOUTUBE_RESEARCH_LOOKBACK_DAYS=30
YOUTUBE_RESEARCH_ORDER=viewCount
YOUTUBE_RESEARCH_QUERY_LIMIT=2
YOUTUBE_RESEARCH_RESULTS_PER_QUERY=5
# Set to 1/true ONLY if you accept that manually approved YouTube
# observations may contribute aggregate features to style training.
YOUTUBE_DERIVED_OBSERVATIONS_APPROVED=

# ── Jamendo (licensed background music search & download) ───────────────────
# https://developer.jamendo.com/ — free client ID
JAMENDO_CLIENT_ID=

# ── Instagram Reels publishing (Graph API) ──────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_API_VERSION=v23.0
# Public HTTPS URL that serves this machine's /output directory
# (Instagram's servers fetch the rendered video from {PUBLIC_BASE_URL}/output/…)
PUBLIC_BASE_URL=

# ── App / storage / logging ──────────────────────────────────────────────────
# Defaults to sqlite:///<project>/data/agent.db when unset
DATABASE_URL=
OUTPUT_DIR=output
LOG_LEVEL=INFO
# Flask dashboard secret key (random one is generated per start if unset)
SECRET_KEY=
# Annotated editing examples for the style learner
EDITING_EXAMPLES_PATH=data/editing_examples.jsonl

# ── FFmpeg ───────────────────────────────────────────────────────────────────
# Binary overrides (defaults: found on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional font file for drawtext title/caption overlays
FFMPEG_FONT_FILE=
# libx264 CPU-fallback tuning. Preset auto-selects by core count when empty
# (<=2 cores: ultrafast, <=4: veryfast, else fast). Lower CRF = higher quality.
FFMPEG_X264_PRESET=
FFMPEG_X264_CRF=19
